<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>farm_twin_poc</name>
  <version>1.0.0</version>
  <description>
    Farm Twin — Proof of Concept
    Team 5 Terra Minds | SDG 2: Zero Hunger | Course 2IRR10 | TU/e
  </description>
  <maintainer email="team5@student.tue.nl">Terra Minds</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav2_simple_commander</depend>
  <depend>action_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <!-- Option B web dashboard (Digital Entity): rosbridge bridges ROS<->browser -->
  <exec_depend>rosbridge_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
